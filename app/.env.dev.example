# Copie para .env.dev (ignorado pelo git) e preencha. Carregado por `pnpm dev` (vite --mode dev).
VITE_SHOW_DEV_CREDS=true
VITE_DEV_EMAIL=
VITE_DEV_PASSWORD=

# API local (padrão): proxy Vite → localhost:3333
VITE_API_URL=/api
VITE_DEV_PROXY_TARGET=http://localhost:3333
# Para usar a API publicada via proxy (sem CORS no browser):
# VITE_DEV_PROXY_TARGET=https://api.copysync.app
