# Variáveis do painel (Vite). Todas opcionais além de VITE_API_URL; a tela degrada sem elas.

# Base da API
VITE_API_URL=/api

# Base do redirect da página de venda (central). O painel monta
# {base}/planos/copysync-{starter|profissional|business}-{mensal|anual} e repassa utm_*/gclid/fbclid.
# Vazia → botão de assinar leva à vitrine interna de planos.
VITE_BILLING_CHECKOUT_URL=
