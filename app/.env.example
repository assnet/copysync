# Variáveis do painel (Vite). Todas opcionais além de VITE_API_URL; a tela degrada sem elas.

# Base da API
VITE_API_URL=/api

# Links de pagamento dos planos ficam no catálogo de vitrine (src/features/plans/catalog.ts), não em env.

# Página da extensão na Chrome Web Store (opcional; padrão em src/features/extension/config.ts)
# VITE_EXTENSION_STORE_URL=https://chromewebstore.google.com/detail/copysync/nokcbnoicaebghagbhlfcbepheohdgnd

# Reserva da site key do Turnstile: o painel lê de GET /auth/login/config (TURNSTILE_SITE_KEY da API); esta só vale se a config falhar.
# VITE_TURNSTILE_SITE_KEY=
