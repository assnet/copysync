{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "Redirect Flow",
  "version": "1.0.0",
  "description": "Captura tokens do Mercado Livre para gerar links de afiliado automaticamente",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.com.ar/*",
    "https://*.mercadolibre.com.mx/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.mercadolivre.com.br/*"],
      "js": ["content.js"]
    }
  ]
}
