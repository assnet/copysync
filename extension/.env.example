# Copie para `.env` (produção, usado por `pnpm build`) e `.env.dev` (usado por `pnpm dev`).
# Ambos são ignorados pelo git. ÚNICA fonte de URL/nome/flags do bundle — nada literal em src/.

# Nome exibido ao usuário (white label: só aqui e em public/_locales).
NAME_APP="CopySync"

# URL base da API, COM o prefixo /api e SEM barra final.
API_URL="https://api.copysync.app/api"
# API_URL="http://localhost:3333/api"

# URL do painel (link "Abrir painel" no popup).
PANEL_URL="https://copysync.app"

# true só no .env.dev: liga devLog e pontos de depuração. Em produção o Terser
# ainda remove todo console.*, mas o gate evita que valores de dev entrem no bundle.
DEV="false"

# Intervalo (minutos) da renovação automática da sessão do Mercado Livre.
SESSION_SYNC_INTERVAL_MINUTES="30"
