generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN // global, outside any specific tenant
  ADMIN // full admin inside a tenant
  OPERATOR // day-to-day operator inside a tenant
}

enum SessionStatus {
  PENDING // created, awaiting first connection attempt
  CONNECTING // initiating connection (socket being opened)
  AWAITING_QR // connection open, waiting for QR scan
  AWAITING_PAIRING // connection open, waiting for pairing code entry
  AWAITING_CODE // Telegram: código de login enviado ao app do usuário, aguardando digitação
  AWAITING_PASSWORD // Telegram: conta com verificação em duas etapas, aguardando a senha
  CONNECTED // connected and operational
  DISCONNECTED // temporarily disconnected (recoverable)
  LOGGED_OUT // explicit logout — credentials cleared
  FAILED // unrecoverable failure
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_LOGGED_IN
  USER_LOGGED_OUT
  TENANT_CREATED
  TENANT_UPDATED
  TENANT_SUSPENDED
  SESSION_CREATED
  SESSION_CONNECTED
  SESSION_DISCONNECTED
  SESSION_LOGGED_OUT
  SESSION_DELETED
  AFFILIATE_CREDENTIAL_UPSERTED
  AFFILIATE_CREDENTIAL_DELETED
  AFFILIATE_SESSION_SYNCED
  INVITE_ACCEPTED
  PASSWORD_RESET_COMPLETED
  MEMBER_INVITED
  MEMBER_CREATED
  MEMBER_DEACTIVATED
  MEMBER_ROLE_CHANGED
  TENANT_STATUS_CHANGED
  BILLING_EVENT_RECEIVED
  AFFILIATE_SESSION_ACCOUNT_RESET
  AFFILIATE_CREDENTIAL_REJECTED
  PREMIUM_SLUG_GRANTED
  PREMIUM_SLUG_REVOKED
  PLAN_ENTITLEMENT_CHANGED
  MARKETPLACE_RISK_ACCEPTED
  WORKER_SCALING_SETTINGS_CHANGED
  WORKER_SCALE_REQUESTED
  INFRA_COST_SETTINGS_CHANGED
  STOREFRONT_DELETED
}

enum ExtensionInstallationStatus {
  ACTIVE
  UNINSTALLED
  INFERRED_GONE
  REPLACED
}

enum HubOutboxEventStatus {
  PENDING
  SENT
  DEAD
}

enum ConversationStatus {
  OPEN // conversa aberta, aguardando ou em atendimento
  PENDING // aguardando primeira resposta do operador
  WAITING // na fila de espera
  BOT // sendo atendida por bot/automação
  CLOSED // encerrada
}

enum ChatMessageDirection {
  INBOUND // mensagem recebida do contato
  OUTBOUND // mensagem enviada pelo operador/sistema
  SYSTEM // evento interno (ex.: "atendimento encerrado")
}

enum ChatMessageType {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  VIDEO
  STICKER
  LOCATION
  VCARD
  CALL_LOG
  EVENT
}

enum ChatMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
  // Gravada e aguardando/enviando ao WhatsApp (só mídia do painel). No fim porque o
  // Postgres anexa o valor novo ao final do tipo; outra posição gera drift no diff.
  PENDING
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id                    String       @id @default(cuid())
  name                  String
  slug                  String       @unique
  status                TenantStatus @default(ACTIVE)
  billingCustomerId     String?      @unique
  planSlug              String?
  lastBillingEventSeq   BigInt?
  suspendedAt           DateTime?
  /// Vencimento da assinatura vindo do hub (`expiresAt`); null = sem vencimento conhecido.
  subscriptionExpiresAt DateTime?
  /// Última passada da reconciliação com a central (rodízio do lote; null = nunca examinado).
  billingReconciledAt   DateTime?
  /// Bloqueio (SUSPENDED/CANCELLED) pelo super-admin; webhook e reconciliação nunca mudam o status enquanto preenchido.
  adminBlockedAt        DateTime?
  /// Pausa global de envios (fila de envio): nada sai enquanto não for null; captura continua.
  sendingPausedAt       DateTime?
  /// Turno da seleção justa de capturas do monitoramento (sequência `monitoring_claim_turn_seq`);
  /// null = nunca atendido. Controle de infra: sem DTO/painel.
  monitoringClaimTurn   BigInt?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  userTenants                UserTenant[]
  sessions                   Session[]
  sessionAuthStates          SessionAuthState[]
  messages                   Message[]
  auditLogs                  AuditLog[]
  chatContacts               ChatContact[]
  chatConversations          ChatConversation[]
  chatMessages               ChatMessage[]
  chatMessageReactions       ChatMessageReaction[]
  chatLists                  ChatList[]
  affiliateCredentials       AffiliateCredential[]
  marketplaceRiskAcceptances MarketplaceRiskAcceptance[]
  userInvites                UserInvite[]
  tenantEntitlements         TenantEntitlement[]
  offers                     Offer[]
  offerDispatches            OfferDispatch[]
  offerDestinations          OfferDestination[]
  offerGeneratorConfig       OfferGeneratorConfig?
  aiCredential               TenantAiCredential?
  aiUsageLogs                AiUsageLog[]
  BillingEventReceipt        BillingEventReceipt[]
  extensionSessions          ExtensionSession[]
  groupMonitorConfigs        GroupMonitorConfig[]
  linkRotations              LinkRotation[]
  linkRotationGroups         LinkRotationGroup[]
  linkSlugReservations       LinkSlugReservation[]
  linkClicks                 LinkClick[]
  publicSlugClaims           PublicSlugClaim[]
  premiumSlugGrants          PremiumSlugGrant[]
  storefront                 Storefront?
  storefrontOffers           StorefrontOffer[]
  sessionHours               TenantSessionHour[]
  costMonths                 InfraCostMonthTenant[]
  offerHunts                 OfferHunt[]
  offerHuntRuns              OfferHuntRun[]
  offerHuntFinds             OfferHuntFind[]
  offerHunterSettings        OfferHunterSettings?
  offerHuntAiSuggestions     OfferHuntAiSuggestion[]

  @@index([slug])
  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String?
  passwordSetAt      DateTime?
  mustChangePassword Boolean   @default(false)
  name               String
  isSuperAdmin       Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  userTenants                UserTenant[]
  refreshTokens              RefreshToken[]
  auditLogs                  AuditLog[]
  assignedConversations      ChatConversation[]          @relation("AssignedConversations")
  createdOffers              Offer[]
  extensionSessions          ExtensionSession[]
  extensionInstallations     ExtensionInstallation[]
  marketplaceRiskAcceptances MarketplaceRiskAcceptance[]
  loginCodes                 LoginCode[]
  passwordResetRequests      PasswordResetRequest[]
  passwordConfirmations      PasswordConfirmationAttempt[]

  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER <-> TENANT  (membership + role)
// ─────────────────────────────────────────────────────────────────────────────

model UserTenant {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      UserRole @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("user_tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER INVITE
// ─────────────────────────────────────────────────────────────────────────────

model UserInvite {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  role        UserRole  @default(OPERATOR)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("user_invites")
}

// ─────────────────────────────────────────────────────────────────────────────
// REFRESH TOKEN
// ─────────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// LOGIN PROTECTION  (docs/seguranca-login.md) — global, não tenant-aware
// ─────────────────────────────────────────────────────────────────────────────

/// Eventos do login: LOGIN_FAILED (sem userId), LOGIN_OK, LOGIN_CODE_VERIFIED. Poda: 30 dias.
model LoginEvent {
  id        String   @id @default(cuid())
  type      String
  email     String
  ip        String?
  userId    String?
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_events")
}

/// Código por e-mail do login suspeito: só o hash. sentAt nulo = envio em andamento. Poda: 1 dia.
model LoginCode {
  id            String    @id @default(cuid())
  userId        String
  codeHash      String
  attempts      Int       @default(0)
  expiresAt     DateTime
  sentAt        DateTime?
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("login_codes")
}

/// Confirmação da senha do usuário logado em ação sensível (docs/seguranca-login.md). A linha nasce
/// `success = false` ANTES do bcrypt (reserva: conta no teto) e vira `true` se a senha confere.
/// Nunca guarda a senha nem derivado dela. `action` é texto (ex.: STOREFRONT_DELETE).
model PasswordConfirmationAttempt {
  id        String   @id @default(cuid())
  userId    String
  action    String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_confirmation_attempts")
}

/// Pedido de redefinição de senha (docs/recuperacao-de-senha.md). Toda requisição grava uma linha
/// (teto por e-mail/IP, exista ou não a conta); tokenHash só quando há conta. Poda: 30 dias.
model PasswordResetRequest {
  id            String    @id @default(cuid())
  email         String
  ip            String?
  userId        String?
  tokenHash     String?   @unique
  expiresAt     DateTime?
  usedAt        DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([userId])
  @@map("password_reset_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// SESSION  (one WhatsApp session per tenant)
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id                 String        @id @default(cuid())
  tenantId           String
  name               String // human-friendly label given by the user
  engine             String        @default("baileys") // engine managing this session
  phone              String? // phone number after successful pairing
  declaredPhone      String? // número informado pelo operador ao criar (55+DDD+número); comparado com `phone`
  externalRef        String? // engine-specific session reference
  status             SessionStatus @default(PENDING)
  lastConnectedAt    DateTime? // when the session last reached CONNECTED
  lastDisconnectedAt DateTime? // when the session last reached DISCONNECTED
  lastSeenAt         DateTime? // timestamp of last inbound/outbound message
  deletedAt          DateTime? // soft-delete
  ownerWorkerId      String? // processo dono do socket (lease); null = sem dono
  leaseUntil         DateTime? // validade do lease; vencido = sessão adotável
  connectRequestedAt DateTime? // pedido de conexão ativo; null = não reconectar
  nextAdoptAt        DateTime? // próxima tentativa de adoção (backoff)
  adoptFailures      Int           @default(0) // falhas seguidas de adoção
  shard              String? // shard que pode adotar; null = qualquer
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant                       Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authState                    SessionAuthState?
  messages                     Message[]
  chatConversations            ChatConversation[]
  authKeys                     SessionAuthKey[]
  offerGeneratorConfigs        OfferGeneratorConfig[]
  offerGeneratorConfigSessions OfferGeneratorConfigSession[]
  groupMonitorConfigs          GroupMonitorConfig[]
  linkRotations                LinkRotation[]
  offerHunterSettings          OfferHunterSettings[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([ownerWorkerId])
  @@index([connectRequestedAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// WORKER HEARTBEAT  (processos vivos e ocupação; docs/arquitetura-escala.md §3.1)
// Sem tenantId: dado operacional da plataforma, não do tenant.
// ─────────────────────────────────────────────────────────────────────────────

model WorkerHeartbeat {
  workerId       String   @id // id do processo (o mesmo do lease)
  role           String // papel do processo: all | worker
  sessions       Int // sessões com login concluído neste processo (ocupam vaga)
  pendingLogins  Int      @default(0) // logins em andamento (QR/código sem leitura); não ocupam vaga
  maxSessions    Int // teto do processo (WORKER_MAX_SESSIONS)
  rssMb          Int // memória residente em MB
  cpuPct         Float? // CPU do Node entre batimentos (%); nullable: deploy sobreposto com imagem antiga (MQ-21)
  eventLoopP99Ms Float? // p99 do atraso do event loop desde o batimento anterior (ms)
  seenAt         DateTime // último batimento (horário do banco, UTC)

  @@index([seenAt])
  @@map("worker_heartbeats")
}

// Amostras de recursos da plataforma (Render, Postgres, workers, sessões), MQ-23/WSCALE-08. Dado de infraestrutura,
// sem tenant. 1 linha por (resource, metric) a cada 5 min; retenção de 7 dias pelo próprio job.
model OpsMetricsSample {
  id       BigInt   @id @default(autoincrement())
  at       DateTime // fim da janela agregada (UTC)
  source   String // render | postgres | worker | sessions
  resource String // id do recurso (srv-/dpg-), workerId, banco, queryid ou cluster (sessões)
  metric   String // ex.: cpu_pct, memory_pct, db_idle_in_transaction, event_loop_p99_ms, sessions_connected
  value    Float // média da janela (gauge) ou último valor (counter)
  meta     Json? // { min, max, n, unit?, shape? }; sem PII nem SQL bruto

  @@index([metric, at])
  @@index([at]) // retenção: DELETE WHERE at < x
  @@map("ops_metrics_samples")
}

// Pedidos de escala dos workers (WSCALE-13). Dado de infraestrutura, sem tenant. Não identifica o ator na
// listagem (quem pediu fica na auditoria). Retenção de 180 dias pelo WorkerAutoscalerJob (P4).
model WorkerScaleEvent {
  id           BigInt   @id @default(autoincrement())
  at           DateTime @default(now()) // UTC
  trigger      String // manual | auto (CHECK no banco)
  actorUserId  String? // User.id (cuid); null = sistema
  fromReplicas Int
  toReplicas   Int
  reason       String   @db.VarChar(200) // truncado no repositório
  outcome      String // requested | succeeded | failed | rejected (CHECK no banco)
  error        String?  @db.VarChar(200) // código/mensagem curta; truncado no repositório
  requestId    String?  @unique // idempotência do POST /scale; null = job automático

  @@index([at(sort: Desc)])
  @@map("worker_scale_events")
}

// Custos da infraestrutura (COST-09/10): snapshots horários. Retenção de 400 dias em lotes pelo
// InfraCostSnapshotJob. Sem id da Render: `resourceKey` é o papel do recurso.
model InfraResourceHour {
  hour            DateTime // hora cheia (UTC)
  resourceKey     String // api | worker | redis | postgres | static (CHECK no banco)
  plan            String? // plano lido na Render; null = sem leitura
  instances       Int
  instancesSource String // samples | render (CHECK no banco)
  diskGb          Int?
  suspended       Boolean  @default(false)
  readAt          DateTime @default(now())

  @@id([hour, resourceKey])
  @@map("infra_resource_hours")
}

// Sessão-hora e contratadas por tenant por dia (UTC). Incremento guardado por `lastHour`.
model TenantSessionHour {
  day                DateTime @db.Date
  tenantId           String
  planSlug           String? // último visto no dia
  connectedHours     Int      @default(0)
  contractedSessions Int      @default(0) // soma horária das contratadas efetivas
  contractedSamples  Int      @default(0) // horas somadas (média = contractedSessions ÷ contractedSamples)
  lastHour           DateTime // última hora somada (UTC)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([day, tenantId])
  @@index([tenantId, day])
  @@map("tenant_session_hours")
}

// Cotação do dólar (PTAX/SGS) por dia de referência.
model InfraFxRate {
  referenceDate DateTime @id @db.Date
  rate          Decimal  @db.Decimal(10, 4)
  source        String // ptax | sgs (CHECK no banco)
  fetchedAt     DateTime @default(now())

  @@map("infra_fx_rates")
}

// Uso medido por dia: banda (acumula horas, guarda por `lastHour`) e minutos de build (regrava o dia).
model InfraUsageDaily {
  day         DateTime  @db.Date
  metric      String // bandwidth_gb | build_minutes (CHECK no banco)
  resourceKey String
  value       Float
  source      String // render_metrics | render_deploys (CHECK no banco)
  lastHour    DateTime?
  /// Banda: horas somadas no dia (build = 0).
  hours       Int       @default(0)
  readAt      DateTime  @default(now())

  @@id([day, metric, resourceKey])
  @@map("infra_usage_daily")
}

// Mês fechado dos custos (COST-15): preços, cotação e método congelados; edição posterior não reescreve.
model InfraCostMonth {
  month           DateTime  @id @db.Date // dia 1 (UTC)
  closingMethod   String // last_business_day | month_average (CHECK no banco)
  fxRate          Decimal?  @db.Decimal(10, 4) // null = sem cotação (só USD)
  fxReferenceDate DateTime? @db.Date
  fxSource        String? // override | ptax | sgs (CHECK no banco)
  totalUsd        Decimal   @db.Decimal(14, 4)
  /// Conta do mês (itens, planos, avisos) e preços usados.
  totals          Json
  closedAt        DateTime  @default(now())

  tenants InfraCostMonthTenant[]

  @@map("infra_cost_months")
}

// Parte de cada tenant no mês fechado (tenant-aware). Índice do cursor: total congelado desc + tenantId.
model InfraCostMonthTenant {
  month         DateTime @db.Date
  tenantId      String
  planSlug      String?
  contractedAvg Float
  sessionHours  Int
  sharedUsd     Decimal  @db.Decimal(14, 4)
  aiUsd         Decimal  @db.Decimal(14, 4)
  totalUsd      Decimal  @db.Decimal(14, 4)

  closedMonth InfraCostMonth @relation(fields: [month], references: [month], onDelete: Cascade)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([month, tenantId])
  @@index([month, totalUsd(sort: Desc), tenantId])
  @@map("infra_cost_month_tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// SESSION AUTH STATE  (persists engine credentials — one record per session)
// ─────────────────────────────────────────────────────────────────────────────

model SessionAuthState {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  tenantId     String
  provider     String   @default("baileys") // engine/provider identifier
  /// LEGADO: blob único com todas as chaves. Substituído por SessionAuthKey (uma linha por chave,
  /// docs/sessoes-auth-state.md). Mantido intacto por uma janela de rollback; depois vira nullable/cai.
  statePayload Json
  /// Incrementa a cada gravação de chaves (lock otimista da escala, §3.1).
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("session_auth_states")
}

/// Estado de autenticação do WhatsApp, UMA LINHA POR CHAVE (`__creds__`, `pre-key__<id>`,
/// `session__<jid>`, `app-state-sync-version__<name>`…). Gravação só do que mudou: o blob único
/// regravava 3–6 MB a cada chave (docs/sessoes-auth-state.md). Valor serializado com BufferJSON.
model SessionAuthKey {
  sessionId String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, key])
  @@map("session_auth_keys")
}

// ─────────────────────────────────────────────────────────────────────────────
// MESSAGE
// ─────────────────────────────────────────────────────────────────────────────

model Message {
  id          String           @id @default(cuid())
  tenantId    String
  sessionId   String
  externalId  String? // WhatsApp-assigned message ID
  direction   MessageDirection
  status      MessageStatus    @default(PENDING)
  from        String
  to          String
  body        String?          @db.Text
  mediaUrl    String?
  mediaType   String? // image | video | audio | document | sticker
  rawPayload  Json? // full original payload for audit / debugging
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  failReason  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([tenantId, status])
  @@index([externalId])
  @@index([from, tenantId])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(cuid())
  tenantId  String? // null for super-admin actions
  userId    String? // null for system actions
  action    AuditAction
  meta      Json? // contextual data (IDs, previous values, etc.)
  ip        String?
  createdAt DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAT CONTACT
// ─────────────────────────────────────────────────────────────────────────────

model ChatContact {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String
  /// LID do WhatsApp (dígitos) visto em 1:1; nulo até a 1ª mensagem com par LID↔telefone
  lid       String?
  avatarUrl String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations ChatConversation[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, lid])
  @@map("chat_contacts")
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAT CONVERSATION
// ─────────────────────────────────────────────────────────────────────────────

model ChatConversation {
  id                 String             @id @default(cuid())
  tenantId           String
  sessionId          String? // sessão WhatsApp vinculada
  contactId          String? // null para conversas de grupo
  externalChatId     String? // ID externo da conversa (ex: JID do WhatsApp)
  channel            String             @default("whatsapp")
  status             ConversationStatus @default(OPEN)
  unreadCount        Int                @default(0)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  assignedUserId     String? // operador responsável
  queueName          String?
  tags               String[]           @default([])
  notes              String?
  // ── Grupos ──────────────────────────────────────────────────────────────
  isGroup            Boolean            @default(false)
  groupJid           String? // JID numérico do grupo (sem @g.us)
  groupName          String? // nome do grupo exibido ao usuário
  groupAvatarUrl     String? // URL pública da foto do grupo
  autoDownloadMedia  Boolean            @default(false) // baixar mídia automaticamente nesta conversa
  archived           Boolean            @default(false) // espelha o arquivamento no WhatsApp
  pinned             Boolean            @default(false) // espelha a fixação no WhatsApp
  mutedUntil         DateTime? // silenciada até; null = com notificações
  favorite           Boolean            @default(false) // marcação local do painel
  manuallyUnread     Boolean            @default(false) // marcada como não lida pelo operador
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session             Session?              @relation(fields: [sessionId], references: [id])
  contact             ChatContact?          @relation(fields: [contactId], references: [id])
  assignedUser        User?                 @relation("AssignedConversations", fields: [assignedUserId], references: [id])
  messages            ChatMessage[]
  offerDispatches     OfferDispatch[]
  offerDestinations   OfferDestination[]
  monitoredGroups     MonitoredGroup[]
  broadcastGroups     BroadcastGroup[]
  linkRotationGroups  LinkRotationGroup[]
  offerHunterSettings OfferHunterSettings[]

  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, sessionId])
  @@index([tenantId, contactId])
  @@index([tenantId, groupJid])
  @@index([tenantId, archived])
  @@index([tenantId, pinned])
  // GIN: `tags @> ARRAY[nome]` nas contagens e cascatas do catálogo de listas.
  @@index([tags], type: Gin)
  @@map("chat_conversations")
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAT LIST — catálogo de listas de conversa do painel
// ─────────────────────────────────────────────────────────────────────────────
// Uma lista é um nome; a associação continua em `ChatConversation.tags`. O catálogo
// garante que a lista exista mesmo sem conversa e é a única porta para renomear/excluir
// (cascata em `tags`). Nunca edite `tags` fora do catálogo — ver docs/chat-listas.md.

model ChatList {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("chat_lists")
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAT MESSAGE
// ─────────────────────────────────────────────────────────────────────────────

model ChatMessage {
  id                     String               @id @default(cuid())
  tenantId               String
  conversationId         String
  direction              ChatMessageDirection
  type                   ChatMessageType      @default(TEXT)
  content                String?              @db.Text
  mediaUrl               String?
  mimeType               String?
  fileName               String? // Nome do arquivo (documentos)
  durationSeconds        Int? // Duração em segundos (áudio/vídeo)
  externalMessageId      String? // ID externo (ex: messageId do WhatsApp)
  status                 ChatMessageStatus?
  isDeleted              Boolean              @default(false)
  quotedMessageId        String? // ID da mensagem citada (reply)
  sentAt                 DateTime?
  // ── Grupos ──────────────────────────────────────────────────────────────
  fromParticipant        String? // phone do remetente dentro do grupo
  fromParticipantName    String? // nome exibido do remetente no grupo
  // ── Prévia de link (docs/mensagens-previa-de-link.md) ───────────────────
  linkPreviewUrl         String?              @db.Text
  linkPreviewTitle       String?
  linkPreviewDescription String?              @db.Text
  /// URL do media store (miniatura gravada); null = cartão sem imagem.
  linkPreviewThumbUrl    String?
  createdAt              DateTime             @default(now())

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  conversation  ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  quotedMessage ChatMessage?          @relation("MessageQuote", fields: [quotedMessageId], references: [id])
  quotedBy      ChatMessage[]         @relation("MessageQuote")
  reactions     ChatMessageReaction[]

  @@index([tenantId, conversationId])
  @@index([conversationId, createdAt])
  // Reação recebida e status de entrega resolvem a mensagem pelo id externo.
  @@index([tenantId, externalMessageId])
  @@map("chat_messages")
}

// Reação de um autor a uma mensagem. Uma linha por (mensagem, autor); a remoção vira
// tombstone (emoji NULL) para que eventos fora de ordem ainda tenham com o que comparar.
model ChatMessageReaction {
  /// Gerado na aplicação (crypto.randomUUID): a escrita não passa pelo create do Prisma.
  id           String   @id
  tenantId     String
  messageId    String
  /// NULL = tombstone (reação removida). Nunca string vazia.
  emoji        String?
  /// "self" para reações nossas (painel ou celular do operador); senão a identidade crua do
  /// protocolo, "lid:<id>" ou "pn:<dígitos>" — nunca o telefone resolvido, que pode mudar.
  reactorKey   String
  /// Telefone do autor quando conhecido; só exibição.
  reactorPhone String?
  /// pushName do autor no momento da reação.
  reactorName  String?
  fromMe       Boolean  @default(false)
  /// key.id da mensagem de reação no WhatsApp.
  externalId   String?
  /// Carimbo de ordem (last-write-wins): senderTimestampMs para terceiros, relógio do servidor
  /// para reações nossas.
  reactedAt    DateTime
  createdAt    DateTime @default(now())
  /// Maior updatedAt da mensagem = revisão do agregado usada pelo painel para ordenar.
  updatedAt    DateTime @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, reactorKey])
  @@index([tenantId, messageId])
  @@map("chat_message_reactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// AFFILIATE CREDENTIALS (integrations)
// ─────────────────────────────────────────────────────────────────────────────

enum AffiliateProvider {
  SHOPEE
  MERCADO_LIVRE
  AMAZON
  SHEIN
}

enum AffiliateCredentialStatus {
  ACTIVE
  INACTIVE
}

model AffiliateCredential {
  id                       String                    @id @default(cuid())
  tenantId                 String
  provider                 AffiliateProvider
  publicIdentifier         String? // null quando a linha nasce da extensão sem tag
  secretCiphertext         Bytes? // AES-256-GCM; AAD = tenantId:provider:secret
  secretIv                 Bytes?
  secretTag                Bytes?
  keyVersion               Int                       @default(1) // versão da chave do secret
  status                   AffiliateCredentialStatus @default(ACTIVE)
  sessionCiphertext        Bytes? // sessão do marketplace vinda da extensão; AAD = tenantId:provider:session
  sessionIv                Bytes?
  sessionTag               Bytes?
  sessionKeyVersion        Int?
  sessionSyncedAt          DateTime?
  sessionInvalidAt         DateTime?
  sessionAccountHash       String?
  sessionAccountKeyVersion Int?
  lastValidatedAt          DateTime?
  /// Loja recusou a credencial no uso (monitoramento pausa a loja); zera ao salvar chave/sessão nova.
  rejectedAt               DateTime?
  rejectedCode             String?
  /// Etiquetas da conta vistas na última sincronização da extensão.
  accountIdentifiers       String[]                  @default([])
  /// Etiquetas vinculadas além da principal (`publicIdentifier`), em ordem.
  linkedIdentifiers        String[]                  @default([])
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("affiliate_credentials")
}

/// Escopo do aviso de risco: link de afiliado (aviso do marketplace) ou caçador de ofertas
/// (busca, link e envio automáticos). Cada escopo tem texto e versão próprios.
enum MarketplaceRiskScope {
  AFFILIATE_LINK
  OFFER_HUNTER
}

/// Aceite do aviso de risco de um marketplace (hoje só SHEIN), por tenant e escopo. Só inclusão:
/// nunca atualizar nem apagar (registro de quem aceitou, quando, qual versão do texto e em que idioma).
model MarketplaceRiskAcceptance {
  id               String               @id @default(cuid())
  tenantId         String
  provider         AffiliateProvider
  scope            MarketplaceRiskScope @default(AFFILIATE_LINK)
  noticeVersion    String
  acceptedByUserId String
  locale           String
  acceptedAt       DateTime             @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  acceptedBy User   @relation(fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, provider, scope, noticeVersion])
  @@index([tenantId, provider])
  @@index([acceptedByUserId])
  @@map("marketplace_risk_acceptances")
}

// ─────────────────────────────────────────────────────────────────────────────
// OFFERS (campaigns) — gerador de ofertas e disparo para grupos
// ─────────────────────────────────────────────────────────────────────────────
// Ver .specs/features/offer-generator/design.md. Limite diário conta `offers`
// por tenantId + createdAt; o worker reivindica `offer_dispatches` por status + notBefore.

/// Origem da oferta na fila de envio.
enum OfferOrigin {
  GENERATOR
  MONITORING
  /// Caçador de ofertas: não conta no `offer_generations_per_day` do gerador.
  HUNTER
}

enum OfferStatus {
  DRAFT
  SENDING
  /// Operador pausou: envios QUEUED esperam; retomar reagenda a partir de agora.
  PAUSED
  SENT
  FAILED
  /// Operador parou: envios QUEUED viram CANCELLED; o que já saiu fica.
  CANCELLED
}

enum OfferDispatchStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
  CANCELLED
}

model Offer {
  id                  String            @id @default(cuid())
  tenantId            String
  provider            AffiliateProvider
  sourceUrl           String            @db.Text
  productRef          String?
  title               String?
  priceCents          Int?
  originalPriceCents  Int?
  imageUrl            String?           @db.Text // URL do media store
  affiliateUrl        String            @db.Text
  attributionVerified Boolean           @default(true)
  text                String            @db.Text
  textEdited          Boolean           @default(false)
  /// Quando o "Gerar novamente" foi usado (vale uma vez por oferta). null = ainda disponível.
  textRegeneratedAt   DateTime?
  coupon              String?
  audience            OfferAudience     @default(STANDARD)
  mentionAll          Boolean           @default(false)
  /// Formato da foto no envio (docs/mensagens-previa-de-link.md).
  imageMode           OfferImageMode    @default(LINK_PREVIEW)
  /// Envia "digitando…" antes da mensagem, por um tempo proporcional ao texto.
  simulateTyping      Boolean           @default(false)
  /// Duração do "digitando…" em segundos (limites em campaigns/domain/offerTyping.ts).
  typingSeconds       Int               @default(15)
  /// Início agendado dos disparos; null = começa ao disparar (teto em campaigns/domain/offerSchedule.ts).
  scheduledAt         DateTime?
  /// Quem criou: gerador (painel) ou monitoramento de grupos (captura automática).
  origin              OfferOrigin       @default(GENERATOR)
  /// Validade: envio com `notBefore` depois disso sai SKIPPED (OFFER_EXPIRED). null = sem validade.
  expiresAt           DateTime?
  /// Chave idempotente de quem criou fora do gerador (ex.: `captured:<id>`): reprocessar não duplica.
  sourceKey           String?           @unique
  /// Oferta do monitoramento: configuração (sessão de ORIGEM) cuja janela de operação vale no envio,
  /// mesmo quando o disparo sai por outra sessão (sessão cruzada). null = sem janela própria.
  monitorConfigId     String?
  status              OfferStatus       @default(DRAFT)
  createdById         String? // null se o usuário for removido
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  dispatches    OfferDispatch[]
  monitorConfig GroupMonitorConfig? @relation(fields: [monitorConfigId], references: [id], onDelete: SetNull)
  huntFinds     OfferHuntFind[]

  @@index([tenantId, createdAt(sort: Desc)])
  // Varredura do worker: ofertas SENDING sem envio aberto
  @@index([status])
  @@index([monitorConfigId])
  @@map("offers")
}

/// Como a foto da oferta vai no WhatsApp: MEDIA = imagem com legenda; LINK_PREVIEW = texto com prévia do link.
enum OfferImageMode {
  MEDIA
  LINK_PREVIEW
}

enum OfferAudience {
  STANDARD
  MOMS
  PET
  BEAUTY_FASHION
  MEN
  FITNESS
  HOME_KITCHEN
}

/// Texto da oferta capturada: ORIGINAL = texto do grupo com links trocados; TEMPLATE = modelo fixo com dados do produto; AI = reescrito pela IA.
enum MonitorTextMode {
  ORIGINAL
  TEMPLATE
  AI
}

/// Configuração do gerador por tenant: sessão que envia e intervalo entre grupos.
/// Ordem do disparo com mais de uma sessão (ver docs/gerador-de-ofertas.md).
enum OfferDispatchOrder {
  SEQUENTIAL // todos os grupos de uma sessão, depois a próxima
  INTERLEAVED // um grupo de cada sessão por vez
}

model OfferGeneratorConfig {
  tenantId           String             @id
  /// Legado: primeira sessão escolhida. Fonte de verdade: `sessions` (OfferGeneratorConfigSession).
  sessionId          String?
  /// Pausa entre dois envios consecutivos, da mesma sessão ou não (segundos).
  intervalMinSeconds Int                @default(120)
  intervalMaxSeconds Int                @default(300)
  dispatchOrder      OfferDispatchOrder @default(SEQUENTIAL)
  /// Janela de postagem do gerador: 0..1440; 0–1440 = dia inteiro; end < start = cruza a meia-noite.
  windowStartMinute  Int                @default(0)
  windowEndMinute    Int                @default(1440)
  /// Dias da semana (bit 0 = domingo; 127 = todos). Fuso America/Sao_Paulo.
  weekdaysMask       Int                @default(127)
  updatedAt          DateTime           @updatedAt

  tenant   Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session  Session?                      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessions OfferGeneratorConfigSession[]

  @@map("offer_generator_configs")
}

/// Sessões que disparam, na ordem escolhida (position). Sessão apagada sai sozinha (Cascade).
model OfferGeneratorConfigSession {
  tenantId  String
  sessionId String
  position  Int

  config  OfferGeneratorConfig @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  session Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([tenantId, sessionId])
  @@index([sessionId])
  @@map("offer_generator_config_sessions")
}

// ─── AI TEXT PROVIDERS ────────────────────────────────────────────────────────

enum AiProviderKind {
  ANTHROPIC
  OPENAI
  GEMINI
  XAI
  DEEPSEEK
  GROQ
  MISTRAL
  OPENROUTER
  /// Endpoint próprio compatível com a API da OpenAI; só para provedores da plataforma.
  OPENAI_COMPATIBLE
}

enum AiUsageSource {
  PLATFORM
  TENANT
}

/// Configuração global da plataforma (chave → JSON). Ex.: `ai.platform.enabled`, `ai.tenant_keys.enabled`.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

/// Provedor de IA da plataforma, cadastrado pelo super admin. Chave cifrada; AAD = `platform:ai:<id>`.
model AiPlatformProvider {
  id                  String         @id @default(cuid())
  kind                AiProviderKind
  label               String
  model               String
  apiKeyCiphertext    Bytes
  apiKeyIv            Bytes
  apiKeyTag           Bytes
  keyVersion          Int            @default(1)
  enabled             Boolean        @default(true)
  priority            Int            @default(0)
  dailyLimitPerTenant Int? // null = sem teto além dos limites do plano
  /// URL base (https, host público) usada só quando kind = OPENAI_COMPATIBLE.
  baseUrl             String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([enabled, priority])
  @@map("ai_platform_providers")
}

/// Chave de IA do próprio tenant. AAD = `<tenantId>:ai:apikey`.
model TenantAiCredential {
  tenantId         String         @id
  kind             AiProviderKind
  model            String
  apiKeyCiphertext Bytes
  apiKeyIv         Bytes
  apiKeyTag        Bytes
  keyVersion       Int            @default(1)
  enabled          Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_ai_credentials")
}

/// Uma linha por chamada de IA (sem prompt nem resposta). Base dos limites diários.
model AiUsageLog {
  id           String         @id @default(cuid())
  tenantId     String
  source       AiUsageSource
  kind         AiProviderKind
  model        String
  providerId   String? // AiPlatformProvider quando source = PLATFORM
  purpose      String
  inputTokens  Int?
  outputTokens Int?
  success      Boolean
  createdAt    DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("ai_usage_logs")
}

model OfferDispatch {
  id                  String              @id @default(cuid())
  tenantId            String
  offerId             String
  conversationId      String
  /// Faixa de envio: cópia de `conversation.sessionId` (sem join no claim). null só em envio antigo
  /// cuja conversa não tinha sessão. Ver docs/fila-de-envio.md.
  sessionId           String?
  /// Intervalo mínimo (s) entre o início do último envio da mesma sessão e este (claim).
  gapSeconds          Int                 @default(0)
  /// Sessão estava fora do ar na vez deste envio: voltou para a fila e segura a vez da sessão até
  /// reconectar (desde quando espera). null = nunca esperou. Ver docs/fila-de-envio.md.
  waitingSessionSince DateTime?
  status              OfferDispatchStatus @default(QUEUED)
  notBefore           DateTime
  claimedAt           DateTime?
  /// Posse do worker: novo uuid a cada claim; resultado só grava com o token da posse.
  claimToken          String?
  chatMessageId       String?
  failureReason       String?
  updatedAt           DateTime            @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offer        Offer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([offerId, conversationId])
  @@index([status, notBefore])
  @@index([sessionId, status])
  // Fila de envio: concluídos do dia por tenant
  @@index([tenantId, updatedAt])
  @@index([tenantId, offerId])
  @@map("offer_dispatches")
}

model OfferDestination {
  tenantId       String
  conversationId String
  /// Ordem de envio (0 = primeiro) dentro da sessão dona do grupo; gravada na ordem de `conversationIds`.
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([tenantId, conversationId])
  @@map("offer_destinations")
}

// ─────────────────────────────────────────────────────────────────────────────
// OFFER HUNTER — caçador de ofertas (Shein). Ver .specs/features/offer-hunter/design.md
// ─────────────────────────────────────────────────────────────────────────────
// Caçada salva → execuções → achados (só os escolhidos são gravados; o teto diário conta achados).
// Excluir a caçada não apaga execuções nem achados (huntId vira null): o teto e a guarda do dia continuam valendo.

enum OfferHuntStatus {
  ACTIVE
  PAUSED
}

enum OfferHuntPauseReason {
  USER
  SOURCE_UNAVAILABLE
  CREDENTIAL_REJECTED
  RISK_NOT_ACCEPTED
  PLAN_UNAVAILABLE
}

/// REVIEW = achados esperam aprovação na tela; AUTO = enfileira direto no envio.
enum OfferHuntDeliveryMode {
  REVIEW
  AUTO
}

/// SKIPPED = execução pulada antes de chamar a fonte (ex.: teto do dia atingido).
enum OfferHuntRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum OfferHuntRunTrigger {
  MANUAL
  SCHEDULED
}

/// Operador do filtro de comissão % (cliente novo): GT >, GTE ≥, LT <.
enum HuntCommissionOperator {
  GT
  GTE
  LT
}

enum OfferHuntFindStatus {
  PENDING_REVIEW
  APPROVED
  DISMISSED
  SENT
  FAILED
}

model OfferHunt {
  id                   String                  @id @default(cuid())
  tenantId             String
  name                 String
  status               OfferHuntStatus         @default(ACTIVE)
  /// Preenchido só com status PAUSED.
  pauseReason          OfferHuntPauseReason?
  /// Marca da caçada (fixa depois de criada); caçadas antigas = SHEIN.
  provider             AffiliateProvider       @default(SHEIN)
  /// Filtros da fonte próprios da marca (ML: `sort`, `extraEarningsOnly`, `bestSellersOnly`); Shein = null.
  sourceOptions        Json?
  /// Configurada pela IA (só registro/exibição).
  aiConfigured         Boolean                 @default(false)
  /// Intenção dada à IA na configuração (só registro/exibição).
  aiIntent             String?                 @db.Text
  // Filtros da fonte (Shein: colunas abaixo)
  /// Código de ordenação da fonte (0 recomendado, 7, 9, 10, 11, 12): dica, a ordem final é a pontuação.
  sort                 Int                     @default(0)
  categoryId           String?
  /// Faixa de comissão da fonte (`commRate`, filtra a RECOMPRA): legado, gravada 5 (ANY) e ignorada pela execução.
  commissionBand       Int?
  keyword              String?
  // Filtros locais (aplicados por nós na resposta); null = sem filtro
  minPriceCents        Int?
  maxPriceCents        Int?
  minDiscountPercent   Int?
  minCommissionPercent Decimal?                @db.Decimal(5, 2)
  /// Como comparar `minCommissionPercent` (0–50); null = sem filtro de comissão %.
  commissionOperator   HuntCommissionOperator?
  minCommissionCents   Int?
  minRating            Decimal?                @db.Decimal(3, 2)
  minSalesBucket       Int?
  minReviewsBucket     Int?
  extraCommissionOnly  Boolean                 @default(false)
  endsWithinDays       Int?
  // Seleção e entrega
  aiEnabled            Boolean                 @default(false)
  topN                 Int                     @default(3)
  repeatAfterDays      Int                     @default(7)
  deliveryMode         OfferHuntDeliveryMode   @default(REVIEW)
  // Agenda (mesmo modelo do gerador: 0..1440, weekdaysMask bit 0 = domingo, fuso America/Sao_Paulo)
  intervalMinutes      Int                     @default(60)
  windowStartMinute    Int                     @default(0)
  windowEndMinute      Int                     @default(1440)
  weekdaysMask         Int                     @default(127)
  nextRunAt            DateTime?
  lastRunAt            DateTime?
  consecutiveFailures  Int                     @default(0)
  /// Posse do job: novo uuid a cada claim; resultado só grava com o token da posse.
  claimToken           String?
  claimedUntil         DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   OfferHuntRun[]
  finds  OfferHuntFind[]

  // Varredura do job: caçadas ativas vencidas
  @@index([status, nextRunAt])
  @@index([tenantId, createdAt])
  @@map("offer_hunts")
}

model OfferHuntRun {
  id           String              @id @default(cuid())
  tenantId     String
  /// null = caçada excluída (a execução segue contando na guarda de 24/dia).
  huntId       String?
  provider     AffiliateProvider   @default(SHEIN)
  trigger      OfferHuntRunTrigger
  status       OfferHuntRunStatus  @default(RUNNING)
  seenCount    Int                 @default(0)
  matchedCount Int                 @default(0)
  chosenCount  Int                 @default(0)
  sentCount    Int                 @default(0)
  aiUsed       Boolean             @default(false)
  aiFallback   Boolean             @default(false)
  errorCode    String?
  /// Candidatos barrados por filtro local `{ minSales: 21, repeated: 2 }`; null = execução antiga ou sem fonte.
  rejectedBy   Json?
  /// Até 15 melhores da execução (só exibição: sem link/token); null = execução antiga ou sem fonte.
  ranking      Json?
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hunt   OfferHunt?      @relation(fields: [huntId], references: [id], onDelete: SetNull)
  finds  OfferHuntFind[]

  // Guarda técnica de execuções por dia
  @@index([tenantId, startedAt])
  // Histórico da caçada
  @@index([huntId, startedAt(sort: Desc)])
  @@map("offer_hunt_runs")
}

model OfferHuntFind {
  id                         String              @id @default(cuid())
  tenantId                   String
  /// null = caçada excluída (o achado segue contando no teto do dia).
  huntId                     String?
  runId                      String?
  provider                   AffiliateProvider   @default(SHEIN)
  /// Id do produto na marca (Shein = goodsId; ML = MLB…). Anulável só por linhas do código antigo: ler COALESCE(productId, goodsId).
  productId                  String?
  /// Só Shein (legado; = productId).
  goodsId                    String?
  skcCode                    String?
  activityId                 String?
  // Retrato do item no momento da execução (só exibição)
  title                      String              @db.Text
  /// Foto da fonte (https, host da marca); null = sem foto.
  imageUrl                   String?             @db.Text
  priceCents                 Int?
  originalPriceCents         Int?
  discountPercent            Int?
  commissionPercent          Decimal?            @db.Decimal(5, 2)
  commissionCents            Int?
  returningCommissionPercent Decimal?            @db.Decimal(5, 2)
  returningCommissionCents   Int?
  extraCommissionCents       Int?
  /// Comissão estimada pela tabela por categoria (ML sem dado do hub).
  commissionEstimated        Boolean             @default(false)
  salesBucket                Int?
  reviewsBucket              Int?
  rating                     Decimal?            @db.Decimal(3, 2)
  /// Pontuação determinística 0–100.
  score                      Int
  /// Fatores da pontuação (só exibição na tela).
  factors                    Json
  aiReason                   String?             @db.Text
  status                     OfferHuntFindStatus @default(PENDING_REVIEW)
  /// Código interno do motivo de FAILED.
  failureReason              String?
  /// Oferta mais recente (o reenvio troca; as anteriores ficam em `offers`).
  offerId                    String?
  /// Reenvios reivindicados pelo painel (não contam no teto de achados; sobem no claim = número do reenvio).
  resendCount                Int                 @default(0)
  lastResentAt               DateTime?
  /// Reenvio em voo até aqui (2º clique recusado); vencido sem troca de oferta = retomável com o mesmo número.
  resendInFlightUntil        DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hunt   OfferHunt?    @relation(fields: [huntId], references: [id], onDelete: SetNull)
  run    OfferHuntRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  offer  Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)

  // Regra de repetição (produto da marca já escolhido pela caçada dentro da janela)
  @@index([huntId, provider, productId, createdAt])
  // Teto diário por tenant
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([runId])
  @@index([offerId])
  @@map("offer_hunt_finds")
}

/// Destino do caçador: 1 grupo por tenant (sessão + conversa). Sessão/conversa apagada vira null.
model OfferHunterSettings {
  tenantId       String   @id
  sessionId      String?
  conversationId String?
  /// Teto diário de reenvios: início do dia (fuso do produto) do contador e reenvios nesse dia.
  resendDayStart DateTime?
  resendsInDay   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session      Session?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  conversation ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([conversationId])
  @@map("offer_hunter_settings")
}

/// Sugestão de configuração pela IA no assistente do caçador (1 linha por chamada; teto/dia por tenant,
/// `HUNTER_AI_LIMITS.aiSuggestionsPerDayMax`). Sem intenção, prompt nem resposta: só a contagem.
model OfferHuntAiSuggestion {
  id        String   @id @default(cuid())
  tenantId  String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("offer_hunt_ai_suggestions")
}

// ─────────────────────────────────────────────────────────────────────────────
// BILLING INTEGRATION
// ─────────────────────────────────────────────────────────────────────────────

model TenantEntitlement {
  id       String @id @default(cuid())
  tenantId String
  key      String
  value    Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_entitlements")
}

model PlanEntitlementPreset {
  id       String @id @default(cuid())
  planSlug String
  key      String
  value    Json?

  @@unique([planSlug, key])
  @@map("plan_entitlement_presets")
}

enum BillingEventOutcome {
  APPLIED
  DUPLICATE
  OUT_OF_ORDER
  IGNORED
  /// Evento de corte com outra assinatura válida do cliente na central (união): tenant mantido ACTIVE.
  KEPT_ACTIVE
}

model BillingEventReceipt {
  eventId           String              @id
  billingCustomerId String?
  tenantId          String?
  type              String
  seq               BigInt
  payload           Json?
  outcome           BillingEventOutcome
  receivedAt        DateTime            @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([billingCustomerId])
  @@index([tenantId])
  @@map("billing_event_receipts")
}

model JobLease {
  name      String   @id
  ownerId   String
  expiresAt DateTime

  @@map("job_leases")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXTENSION BRIDGE
// ─────────────────────────────────────────────────────────────────────────────

model ExtensionInstallation {
  installationId         String                      @id // UUID validated on the server
  extensionId            String
  channel                String // "chrome"
  deviceId               String?
  userId                 String?
  version                String
  status                 ExtensionInstallationStatus @default(ACTIVE)
  firstSeenAt            DateTime                    @default(now())
  installedAt            DateTime?
  lastSeenAt             DateTime                    @default(now())
  lastHeartbeatAt        DateTime?
  lastSiteSeenAt         DateTime?
  uninstalledAt          DateTime?
  previousInstallationId String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  user              User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions          ExtensionSession[]
  lifecycleEvents   ExtensionLifecycleEvent[]
  uninstallFeedback ExtensionUninstallFeedback?

  @@index([deviceId, extensionId])
  @@index([userId])
  @@index([status, lastSeenAt])
  @@map("extension_installations")
}

model ExtensionSession {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  prevTokenHash     String?
  prevValidUntil    DateTime?
  userId            String
  installationId    String
  mlTenantId        String
  extVersion        String
  mlConsentAt       DateTime?
  /// Consentimento para sincronizar a sessão da Shein; zera ao re-vincular a outro tenant.
  sheinConsentAt    DateTime?
  lastSeenAt        DateTime  @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation ExtensionInstallation @relation(fields: [installationId], references: [installationId], onDelete: Cascade)
  tenant       Tenant                @relation(fields: [mlTenantId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId])
  @@index([prevTokenHash])
  @@index([mlTenantId])
  @@index([absoluteExpiresAt])
  @@map("extension_sessions")
}

/// Evento do ciclo de vida. `installationId` nulo só em STORE_CLICK ainda não atribuído: o clique
/// ganha a instalação quando o mesmo usuário vincula a primeira extensão (docs/extensao-navegador.md).
model ExtensionLifecycleEvent {
  id             String   @id @default(cuid())
  installationId String?
  type           String
  occurredAt     DateTime @default(now())
  userId         String?
  tenantId       String?
  /// Onde o clique na loja aconteceu (settings | ml_wizard | onboarding). Só STORE_CLICK.
  source         String?
  channel        String
  version        String
  dedupeKey      String
  createdAt      DateTime @default(now())

  installation ExtensionInstallation? @relation(fields: [installationId], references: [installationId], onDelete: Cascade)

  @@unique([installationId, dedupeKey])
  @@index([occurredAt])
  @@index([userId, type, occurredAt])
  @@map("extension_lifecycle_events")
}

/// Pesquisa da página pública de desinstalação: motivos fixos + comentário curto. Reenvio substitui.
model ExtensionUninstallFeedback {
  id             String   @id @default(cuid())
  installationId String   @unique
  reasons        String[]
  comment        String?  @db.VarChar(500)
  version        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  installation ExtensionInstallation @relation(fields: [installationId], references: [installationId], onDelete: Cascade)

  @@map("extension_uninstall_feedbacks")
}

model HubOutboxEvent {
  id             String               @id @default(cuid())
  clientKey      String
  seq            Int
  /// Nulo em `extension.lifecycle` STORE_CLICK (clique antes de existir instalação).
  installationId String?
  type           String
  payload        Json
  status         HubOutboxEventStatus @default(PENDING)
  attempts       Int                  @default(0)
  nextAttemptAt  DateTime?
  lockedUntil    DateTime?
  sentAt         DateTime?
  createdAt      DateTime             @default(now())

  @@unique([clientKey, seq])
  @@index([status, nextAttemptAt])
  @@map("hub_outbox_events")
}

model HubOutboxSequence {
  clientKey String @id
  lastSeq   Int    @default(0)

  @@map("hub_outbox_sequences")
}

// ─────────────────────────────────────────────────────────────────────────────
// MONITORAMENTO DE GRUPOS (docs/monitoramento-grupos.md)
// ─────────────────────────────────────────────────────────────────────────────

/// Captura de oferta: PENDING (gravada pelo listener) → PROCESSING (claim) → QUEUED (oferta na
/// fila de envio) | SKIPPED (regra) | FAILED (erro). O envio em si é acompanhado por OfferDispatch.
enum CapturedOfferStatus {
  PENDING
  PROCESSING
  QUEUED
  SKIPPED
  FAILED
}

/// Configuração do monitoramento de UMA sessão. Janela em minutos do dia (America/Sao_Paulo).
model GroupMonitorConfig {
  id                   String          @id @default(cuid())
  tenantId             String
  sessionId            String
  enabled              Boolean         @default(false)
  /// 0..1440; start=0 e end=1440 = sem restrição; end < start = cruza a meia-noite. Padrão 06:00–18:00.
  windowStartMinute    Int             @default(360)
  windowEndMinute      Int             @default(1080)
  /// Dias da semana da janela (bit 0 = domingo; 127 = todos). Faixa que cruza a meia-noite pertence ao dia do início.
  weekdaysMask         Int             @default(127)
  /// Fora da janela: true = captura continua e acumula a fila (sai quando a janela abrir); false = não captura.
  /// Só vale no Max (`capture_outside_window_enabled`); sem o plano conta como false.
  captureOutsideWindow Boolean         @default(true)
  /// Padrão sem intervalo (0–0): o painel sugere espaçar conforme o volume.
  intervalMinSeconds   Int             @default(0)
  intervalMaxSeconds   Int             @default(0)
  /// Espera depois da captura antes do 1º envio.
  startDelaySeconds    Int             @default(0)
  /// Validade sem cupom / com cupom (minutos desde a captura).
  maxOfferAgeMinutes   Int             @default(1440)
  couponMaxAgeMinutes  Int             @default(1440)
  mentionAll           Boolean         @default(false)
  simulateTyping       Boolean         @default(true)
  typingSeconds        Int             @default(3)
  /// Como montar o texto enviado (docs/monitoramento-grupos.md §2.4).
  textMode             MonitorTextMode @default(ORIGINAL)
  /// Público da IA (só com textMode AI; STANDARD = modelo fixo).
  audience             OfferAudience   @default(STANDARD)
  /// Captura só com link vira oferta montada mesmo em ORIGINAL. Recurso Pro/Max (`enrich_link_only_enabled`).
  enrichLinkOnly       Boolean         @default(false)
  /// Formato da foto nas ofertas criadas por esta configuração (copiado para Offer.imageMode).
  /// MEDIA desligado no envio até nova decisão (`effectiveImageMode`).
  imageMode            OfferImageMode  @default(LINK_PREVIEW)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session         Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  monitoredGroups MonitoredGroup[]
  broadcastGroups BroadcastGroup[]
  capturedOffers  CapturedOffer[]
  offers          Offer[]

  @@unique([tenantId, sessionId])
  @@index([sessionId])
  @@map("group_monitor_configs")
}

/// Grupo de origem (concorrente). `groupJid` copiado da conversa: o listener decide sem join.
model MonitoredGroup {
  id             String   @id @default(cuid())
  tenantId       String
  sessionId      String
  configId       String
  conversationId String
  /// Sem `@g.us`, como no chat e no evento MESSAGE_RECEIVED.
  groupJid       String
  /// Vazio = captura toda mensagem com link suportado.
  keywords       String[]
  createdAt      DateTime @default(now())

  config        GroupMonitorConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  conversation  ChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  capturedOffer CapturedOffer[]

  @@unique([tenantId, sessionId, groupJid])
  @@index([sessionId, groupJid])
  @@index([tenantId])
  @@map("monitored_groups")
}

/// Grupo de disparo (destino). Ordem de envio = `position`.
model BroadcastGroup {
  id             String   @id @default(cuid())
  tenantId       String
  sessionId      String
  configId       String
  conversationId String
  groupJid       String
  position       Int
  createdAt      DateTime @default(now())

  config       GroupMonitorConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  conversation ChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sessionId, conversationId])
  @@index([tenantId])
  @@map("broadcast_groups")
}

/// Mensagem capturada de um grupo monitorado. Nunca guarda o link de afiliado da origem fora de
/// `sourceText` (auditoria); o que vai para o envio é `finalText`/`affiliateUrl` do tenant.
model CapturedOffer {
  id                      String              @id @default(cuid())
  tenantId                String
  sessionId               String
  configId                String
  monitoredGroupId        String?
  sourceExternalMessageId String
  sourceText              String              @db.Text
  /// URL do media store (só imagem JPEG/PNG/WebP); null = só texto.
  sourceMediaUrl          String?             @db.Text
  imageUnavailable        Boolean             @default(false)
  marketplace             AffiliateProvider?
  sourceUrl               String?             @db.Text
  affiliateUrl            String?             @db.Text
  coupon                  String?
  finalText               String?             @db.Text
  status                  CapturedOfferStatus @default(PENDING)
  /// Motivo de SKIPPED/FAILED (código interno).
  reason                  String?
  offerId                 String?
  /// De onde saiu o texto enviado; null até processar.
  textSource              MonitorTextMode?
  /// Código AI_* quando a IA foi pedida e caiu no modelo.
  aiErrorCode             String?
  startsAt                DateTime?
  expiresAt               DateTime?
  capturedAt              DateTime            @default(now())
  processedAt             DateTime?
  claimToken              String?
  claimedAt               DateTime?
  updatedAt               DateTime            @updatedAt

  config         GroupMonitorConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  monitoredGroup MonitoredGroup?    @relation(fields: [monitoredGroupId], references: [id], onDelete: SetNull)

  @@unique([sessionId, sourceExternalMessageId])
  @@index([status, capturedAt])
  @@index([tenantId, status, capturedAt])
  @@index([tenantId, sessionId, capturedAt(sort: Desc)])
  @@map("captured_offers")
}

// ─────────────────────────────────────────────────────────────────────────────
// LINK ROTATION — rodízio de links de convite de grupos (docs: .specs/features/link-rotation)
// ─────────────────────────────────────────────────────────────────────────────
// Domínio curto (plataforma, sem tenantId) → rotação (slug do tenant) → grupos da sessão.
// O clique público escolhe um grupo elegível e redireciona para o convite.

enum LinkDomainStatus {
  ACTIVE
  PAUSED
}

enum LinkRotationStatus {
  ACTIVE
  PAUSED
  PAUSED_BY_PLAN
}

enum LinkRotationStrategy {
  BALANCED
  SEQUENTIAL
  WEIGHTED
  RANDOM
}

enum LinkRotationGroupStatus {
  ACTIVE
  PAUSED
  FULL
  NEEDS_LINK
  PAUSED_BY_PLAN
}

enum LinkRotationGroupLinkSource {
  AUTO
  MANUAL
}

/// Domínio de links da plataforma (sem tenantId; gerido pelo super-admin).
model LinkDomain {
  id            String           @id @default(cuid())
  hostname      String           @unique // minúsculo, sem ponto final (ex.: "copysync.app")
  status        LinkDomainStatus @default(ACTIVE)
  landingUrl    String? // destino 301 do apex
  reservedNames String[]         @default([]) // além dos padrão (www, app, api, admin…)
  premiumNames  String[]         @default([]) // só com PremiumSlugGrant do tenant
  lastProbeAt   DateTime?
  lastProbeOk   Boolean?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  rotations         LinkRotation[]
  slugReservations  LinkSlugReservation[]
  publicSlugClaims  PublicSlugClaim[]
  premiumSlugGrants PremiumSlugGrant[]

  @@map("link_domains")
}

model LinkRotation {
  id                String               @id @default(cuid())
  tenantId          String
  sessionId         String // sessão dona dos grupos
  domainId          String
  slug              String
  status            LinkRotationStatus   @default(ACTIVE)
  strategy          LinkRotationStrategy @default(BALANCED)
  title             String? // nome exibido na página pública (default: nome da sessão)
  clickCount        Int                  @default(0)
  lastClickAt       DateTime?
  allFullNotifiedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session Session             @relation(fields: [sessionId], references: [id], onDelete: NoAction)
  domain  LinkDomain          @relation(fields: [domainId], references: [id], onDelete: Restrict)
  groups  LinkRotationGroup[]
  clicks  LinkClick[]
  claim   PublicSlugClaim?

  @@unique([domainId, slug])
  @@index([tenantId])
  @@index([sessionId])
  @@map("link_rotations")
}

model LinkRotationGroup {
  id              String                       @id @default(cuid())
  tenantId        String
  rotationId      String
  conversationId  String // ChatConversation (isGroup)
  groupJid        String // sem @g.us, cópia para o job
  position        Int // ordem (SEQUENTIAL)
  weight          Int                          @default(1) // 1–100 (WEIGHTED)
  capacity        Int                          @default(1000) // teto 50–1024
  inviteCode      String? // só o code; link = https://chat.whatsapp.com/<code>
  linkSource      LinkRotationGroupLinkSource?
  status          LinkRotationGroupStatus      @default(ACTIVE)
  memberCount     Int? // última leitura via sessão
  memberCountAt   DateTime?
  clicksSinceSync Int                          @default(0)
  clickCount      Int                          @default(0)
  lastClickAt     DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  rotation     LinkRotation     @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clicks       LinkClick[]

  @@unique([rotationId, conversationId])
  @@index([tenantId])
  @@map("link_rotation_groups")
}

/// Nome trocado/excluído fica reservado ao tenant por 30 dias.
model LinkSlugReservation {
  id        String   @id @default(cuid())
  domainId  String
  slug      String
  tenantId  String
  expiresAt DateTime

  domain LinkDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([domainId, slug])
  @@map("link_slug_reservations")
}

/// Uma linha por clique contado; base para "7 dias" e dedupe. Retenção 90 dias (job).
model LinkClick {
  id             String   @id @default(cuid())
  tenantId       String
  rotationId     String
  groupId        String?
  ipHash         String // sha256(ip + dia + LINK_CLICK_SALT)
  userAgentClass String // 'webview' | 'browser' | 'bot'
  createdAt      DateTime @default(now())

  rotation LinkRotation       @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group    LinkRotationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([rotationId, createdAt])
  @@map("link_clicks")
}

// ─────────────────────────────────────────────────────────────────────────────
// PÁGINA DE OFERTAS (storefront) + NAMESPACE PÚBLICO <slug>.<domínio>
// ─────────────────────────────────────────────────────────────────────────────

enum PublicSlugKind {
  LINK_ROTATION
  STOREFRONT
}

enum PremiumSlugGrantSource {
  MANUAL
  BILLING
}

/// Dono único de <slug>.<domínio>. Rodízio e página disputam o mesmo namespace.
/// Exatamente um de linkRotationId/storefrontId (CHECK no SQL da migration, coerente com `kind`).
model PublicSlugClaim {
  id             String         @id @default(cuid())
  domainId       String
  slug           String
  kind           PublicSlugKind
  tenantId       String
  linkRotationId String?        @unique
  storefrontId   String?        @unique
  createdAt      DateTime       @default(now())

  domain       LinkDomain    @relation(fields: [domainId], references: [id], onDelete: Restrict)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linkRotation LinkRotation? @relation(fields: [linkRotationId], references: [id], onDelete: Cascade)
  storefront   Storefront?   @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@unique([domainId, slug])
  @@index([tenantId])
  @@map("public_slug_claims")
}

/// Liberação de um nome premium (LinkDomain.premiumNames) para um tenant.
model PremiumSlugGrant {
  id        String                 @id @default(cuid())
  domainId  String
  slug      String
  tenantId  String
  source    PremiumSlugGrantSource
  expiresAt DateTime?
  createdAt DateTime               @default(now())

  domain LinkDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)
  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([domainId, slug])
  @@map("premium_slug_grants")
}

enum StorefrontStatus {
  ACTIVE
  PAUSED_BY_PLAN
}

enum StorefrontOfferStatus {
  DRAFT
  PUBLISHED
}

/// Uma página por tenant. Domínio e slug vêm do PublicSlugClaim (sem cópia aqui, sem drift).
model Storefront {
  id              String           @id @default(cuid())
  tenantId        String           @unique
  title           String
  subtitle        String?
  avatarUrl       String?
  coverUrl        String?
  colorPrimary    String           @default("#2563EB")
  colorBackground String           @default("#F5F5F5")
  colorCard       String           @default("#FFFFFF")
  categories      String[]         @default([])
  status          StorefrontStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claim  PublicSlugClaim?
  offers StorefrontOffer[]

  @@map("storefronts")
}

model StorefrontOffer {
  id                  String                @id @default(cuid())
  tenantId            String
  storefrontId        String
  status              StorefrontOfferStatus @default(DRAFT)
  position            Int
  provider            AffiliateProvider
  sourceUrl           String
  affiliateUrl        String
  attributionVerified Boolean               @default(false)
  title               String
  priceCents          Int?
  originalPriceCents  Int?
  imageUrl            String?
  category            String?
  publishedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  storefront Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([storefrontId, status, position])
  @@index([tenantId])
  @@map("storefront_offers")
}

// ─────────────────────────────────────────────────────────────────────────────
// REDIRECT LINKS  (links de marketing/suporte da PLATAFORMA — docs/redirect-links.md)
// Sem tenantId de propósito: o link é da plataforma, só o super-admin gerencia e a rota
// pública (`/redirect/<slug>`) resolve sem contexto de tenant.
// ─────────────────────────────────────────────────────────────────────────────

model RedirectLink {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(100) // minúsculo, [a-z0-9.-]; editável (o antigo para de responder)
  urlA      String   @db.VarChar(2048) // só https://
  urlB      String?  @db.VarChar(2048) // null = 100% A
  percentA  Int      @default(100) // inteiro 0–100 (CHECK no banco); sem B é sempre 100
  isActive  Boolean  @default(true)
  hitsA     Int      @default(0) // UPDATE … SET "hitsA" = "hitsA" + 1
  hitsB     Int      @default(0)
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("redirect_links")
}
