}

model ExtensionLifecycleEvent {
  id             String   @id @default(cuid())
  installationId String
  type           String
  occurredAt     DateTime @default(now())
  userId         String?
  channel        String
  version        String
  dedupeKey      String
  createdAt      DateTime @default(now())

  installation ExtensionInstallation @relation(fields: [installationId], references: [installationId], onDelete: Cascade)

  @@unique([installationId, dedupeKey])
  @@index([occurredAt])
  @@map("extension_lifecycle_events")
}

model HubOutboxEvent {
  id             String               @id @default(cuid())
  clientKey      String
  seq            Int
  installationId String
  type           String
  payload        Json
  status         HubOutboxEventStatus @default(PENDING)
  attempts       Int                  @default(0)
  nextAttemptAt  DateTime?
  lockedUntil    DateTime?
  sentAt         DateTime?
  createdAt      DateTime             @default(now())

  @@unique([clientKey, seq])
  @@index([status, nextAttemptAt])
  @@map("hub_outbox_events")
}

model HubOutboxSequence {
  clientKey String @id
  lastSeq   Int    @default(0)

  @@map("hub_outbox_sequences")
}

// ─────────────────────────────────────────────────────────────────────────────
// MONITORAMENTO DE GRUPOS (docs/monitoramento-grupos.md)
// ─────────────────────────────────────────────────────────────────────────────

/// Captura de oferta: PENDING (gravada pelo listener) → PROCESSING (claim) → QUEUED (oferta na
/// fila de envio) | SKIPPED (regra) | FAILED (erro). O envio em si é acompanhado por OfferDispatch.
enum CapturedOfferStatus {
  PENDING
  PROCESSING
  QUEUED
  SKIPPED
  FAILED
}

/// Configuração do monitoramento de UMA sessão. Janela em minutos do dia (America/Sao_Paulo).
model GroupMonitorConfig {
  id                   String          @id @default(cuid())
  tenantId             String
  sessionId            String
  enabled              Boolean         @default(false)
  /// 0..1440; start=0 e end=1440 = sem restrição; end < start = cruza a meia-noite. Padrão 06:00–18:00.
  windowStartMinute    Int             @default(360)
  windowEndMinute      Int             @default(1080)
  /// Fora da janela: true = captura continua e acumula a fila (sai quando a janela abrir); false = não captura.
  captureOutsideWindow Boolean         @default(true)
  /// Padrão 15–40 min: repostagem de oferta capturada é mais espaçada que o gerador (2–5 min).
  intervalMinSeconds   Int             @default(900)
  intervalMaxSeconds   Int             @default(2400)
  /// Espera depois da captura antes do 1º envio.
  startDelaySeconds    Int             @default(0)
  /// Validade sem cupom / com cupom (minutos desde a captura).
  maxOfferAgeMinutes   Int             @default(180)
  couponMaxAgeMinutes  Int             @default(60)
  mentionAll           Boolean         @default(false)
  simulateTyping       Boolean         @default(false)
  typingSeconds        Int             @default(15)
  /// Como montar o texto enviado (docs/monitoramento-grupos.md §2.4).
  textMode             MonitorTextMode @default(ORIGINAL)
  /// Público da IA (só com textMode AI; STANDARD = modelo fixo).
  audience             OfferAudience   @default(STANDARD)
  /// Captura só com link vira oferta montada mesmo em ORIGINAL.
  enrichLinkOnly       Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session         Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  monitoredGroups MonitoredGroup[]
  broadcastGroups BroadcastGroup[]
  capturedOffers  CapturedOffer[]
  offers          Offer[]

  @@unique([tenantId, sessionId])
  @@index([sessionId])
  @@map("group_monitor_configs")
}

/// Grupo de origem (concorrente). `groupJid` copiado da conversa: o listener decide sem join.
model MonitoredGroup {
  id             String   @id @default(cuid())
  tenantId       String
  sessionId      String
  configId       String
  conversationId String
  /// Sem `@g.us`, como no chat e no evento MESSAGE_RECEIVED.
  groupJid       String
  /// Vazio = captura toda mensagem com link suportado.
  keywords       String[]
  createdAt      DateTime @default(now())

  config        GroupMonitorConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  conversation  ChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  capturedOffer CapturedOffer[]

  @@unique([tenantId, sessionId, groupJid])
  @@index([sessionId, groupJid])
  @@index([tenantId])
  @@map("monitored_groups")
}

/// Grupo de disparo (destino). Ordem de envio = `position`.
model BroadcastGroup {
  id             String   @id @default(cuid())
  tenantId       String
  sessionId      String
  configId       String
  conversationId String
  groupJid       String
  position       Int
  createdAt      DateTime @default(now())

  config       GroupMonitorConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  conversation ChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sessionId, conversationId])
  @@index([tenantId])
  @@map("broadcast_groups")
}

/// Mensagem capturada de um grupo monitorado. Nunca guarda o link de afiliado da origem fora de
/// `sourceText` (auditoria); o que vai para o envio é `finalText`/`affiliateUrl` do tenant.
model CapturedOffer {
  id                      String              @id @default(cuid())
  tenantId                String
  sessionId               String
  configId                String
  monitoredGroupId        String?
  sourceExternalMessageId String
  sourceText              String              @db.Text
  /// URL do media store (só imagem JPEG/PNG/WebP); null = só texto.
  sourceMediaUrl          String?             @db.Text
  imageUnavailable        Boolean             @default(false)
  marketplace             AffiliateProvider?
  sourceUrl               String?             @db.Text
  affiliateUrl            String?             @db.Text
  coupon                  String?
  finalText               String?             @db.Text
  status                  CapturedOfferStatus @default(PENDING)
  /// Motivo de SKIPPED/FAILED (código interno).
  reason                  String?
  offerId                 String?
  /// De onde saiu o texto enviado; null até processar.
  textSource              MonitorTextMode?
  /// Código AI_* quando a IA foi pedida e caiu no modelo.
  aiErrorCode             String?
  startsAt                DateTime?
  expiresAt               DateTime?
  capturedAt              DateTime            @default(now())
  processedAt             DateTime?
  claimToken              String?
  claimedAt               DateTime?
  updatedAt               DateTime            @updatedAt

  config         GroupMonitorConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  monitoredGroup MonitoredGroup?    @relation(fields: [monitoredGroupId], references: [id], onDelete: SetNull)

  @@unique([sessionId, sourceExternalMessageId])
  @@index([status, capturedAt])
  @@index([tenantId, status, capturedAt])
  @@index([tenantId, sessionId, capturedAt(sort: Desc)])
  @@map("captured_offers")
}

// ─────────────────────────────────────────────────────────────────────────────
// LINK ROTATION — rodízio de links de convite de grupos (docs: .specs/features/link-rotation)
// ─────────────────────────────────────────────────────────────────────────────
// Domínio curto (plataforma, sem tenantId) → rotação (slug do tenant) → grupos da sessão.
// O clique público escolhe um grupo elegível e redireciona para o convite.

enum LinkDomainStatus {
  ACTIVE
  PAUSED
}

enum LinkRotationStatus {
  ACTIVE
  PAUSED
  PAUSED_BY_PLAN
}

enum LinkRotationStrategy {
  BALANCED
  SEQUENTIAL
  WEIGHTED
  RANDOM
}

enum LinkRotationGroupStatus {
  ACTIVE
  PAUSED
  FULL
  NEEDS_LINK
  PAUSED_BY_PLAN
}

enum LinkRotationGroupLinkSource {
  AUTO
  MANUAL
}

/// Domínio de links da plataforma (sem tenantId; gerido pelo super-admin).
model LinkDomain {
  id            String           @id @default(cuid())
  hostname      String           @unique // minúsculo, sem ponto final (ex.: "copysync.app")
  status        LinkDomainStatus @default(ACTIVE)
  landingUrl    String? // destino 301 do apex
  reservedNames String[]         @default([]) // além dos padrão (www, app, api, admin…)
  premiumNames  String[]         @default([]) // só com PremiumSlugGrant do tenant
  lastProbeAt   DateTime?
  lastProbeOk   Boolean?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  rotations         LinkRotation[]
  slugReservations  LinkSlugReservation[]
  publicSlugClaims  PublicSlugClaim[]
  premiumSlugGrants PremiumSlugGrant[]

  @@map("link_domains")
}

model LinkRotation {
  id                String               @id @default(cuid())
  tenantId          String
  sessionId         String // sessão dona dos grupos
  domainId          String
  slug              String
  status            LinkRotationStatus   @default(ACTIVE)
  strategy          LinkRotationStrategy @default(BALANCED)
  title             String? // nome exibido na página pública (default: nome da sessão)
  clickCount        Int                  @default(0)
  lastClickAt       DateTime?
  allFullNotifiedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session Session             @relation(fields: [sessionId], references: [id], onDelete: NoAction)
  domain  LinkDomain          @relation(fields: [domainId], references: [id], onDelete: Restrict)
  groups  LinkRotationGroup[]
  clicks  LinkClick[]
  claim   PublicSlugClaim?

  @@unique([domainId, slug])
  @@index([tenantId])
  @@index([sessionId])
  @@map("link_rotations")
}

model LinkRotationGroup {
  id              String                       @id @default(cuid())
  tenantId        String
  rotationId      String
  conversationId  String // ChatConversation (isGroup)
  groupJid        String // sem @g.us, cópia para o job
  position        Int // ordem (SEQUENTIAL)
  weight          Int                          @default(1) // 1–100 (WEIGHTED)
  capacity        Int                          @default(1000) // teto 50–1024
  inviteCode      String? // só o code; link = https://chat.whatsapp.com/<code>
  linkSource      LinkRotationGroupLinkSource?
  status          LinkRotationGroupStatus      @default(ACTIVE)
  memberCount     Int? // última leitura via sessão
  memberCountAt   DateTime?
  clicksSinceSync Int                          @default(0)
  clickCount      Int                          @default(0)
  lastClickAt     DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  rotation     LinkRotation     @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clicks       LinkClick[]

  @@unique([rotationId, conversationId])
  @@index([tenantId])
  @@map("link_rotation_groups")
}

/// Nome trocado/excluído fica reservado ao tenant por 30 dias.
model LinkSlugReservation {
  id        String   @id @default(cuid())
  domainId  String
  slug      String
  tenantId  String
  expiresAt DateTime

  domain LinkDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([domainId, slug])
  @@map("link_slug_reservations")
}

/// Uma linha por clique contado; base para "7 dias" e dedupe. Retenção 90 dias (job).
model LinkClick {
  id             String   @id @default(cuid())
  tenantId       String
  rotationId     String
  groupId        String?
  ipHash         String // sha256(ip + dia + LINK_CLICK_SALT)
  userAgentClass String // 'webview' | 'browser' | 'bot'
  createdAt      DateTime @default(now())

  rotation LinkRotation       @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group    LinkRotationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([rotationId, createdAt])
  @@map("link_clicks")
}

// ─────────────────────────────────────────────────────────────────────────────
// PÁGINA DE OFERTAS (storefront) + NAMESPACE PÚBLICO <slug>.<domínio>
// ─────────────────────────────────────────────────────────────────────────────

enum PublicSlugKind {
  LINK_ROTATION
  STOREFRONT
}

enum PremiumSlugGrantSource {
  MANUAL
  BILLING
}

/// Dono único de <slug>.<domínio>. Rodízio e página disputam o mesmo namespace.
/// Exatamente um de linkRotationId/storefrontId (CHECK no SQL da migration, coerente com `kind`).
model PublicSlugClaim {
  id             String         @id @default(cuid())
  domainId       String
  slug           String
  kind           PublicSlugKind
  tenantId       String
  linkRotationId String?        @unique
  storefrontId   String?        @unique
  createdAt      DateTime       @default(now())

  domain       LinkDomain    @relation(fields: [domainId], references: [id], onDelete: Restrict)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linkRotation LinkRotation? @relation(fields: [linkRotationId], references: [id], onDelete: Cascade)
  storefront   Storefront?   @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@unique([domainId, slug])
  @@index([tenantId])
  @@map("public_slug_claims")
}

/// Liberação de um nome premium (LinkDomain.premiumNames) para um tenant.
model PremiumSlugGrant {
  id        String                 @id @default(cuid())
  domainId  String
  slug      String
  tenantId  String
  source    PremiumSlugGrantSource
  expiresAt DateTime?
  createdAt DateTime               @default(now())

  domain LinkDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)
  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([domainId, slug])
  @@map("premium_slug_grants")
}

enum StorefrontStatus {
  ACTIVE
  PAUSED_BY_PLAN
}

enum StorefrontOfferStatus {
  DRAFT
  PUBLISHED
}

/// Uma página por tenant. Domínio e slug vêm do PublicSlugClaim (sem cópia aqui, sem drift).
model Storefront {
  id              String           @id @default(cuid())
  tenantId        String           @unique
  title           String
  subtitle        String?
  avatarUrl       String?
  coverUrl        String?
  colorPrimary    String           @default("#2563EB")
  colorBackground String           @default("#F5F5F5")
  colorCard       String           @default("#FFFFFF")
  categories      String[]         @default([])
  status          StorefrontStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claim  PublicSlugClaim?
  offers StorefrontOffer[]

  @@map("storefronts")
}

model StorefrontOffer {
  id                  String                @id @default(cuid())
  tenantId            String
  storefrontId        String
  status              StorefrontOfferStatus @default(DRAFT)
  position            Int
  provider            AffiliateProvider
  sourceUrl           String
  affiliateUrl        String
  attributionVerified Boolean               @default(false)
  title               String
  priceCents          Int?
  originalPriceCents  Int?
  imageUrl            String?
  category            String?
  publishedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  storefront Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([storefrontId, status, position])
  @@index([tenantId])
  @@map("storefront_offers")
}
