{
  "name": "waioprime-api",
  "version": "0.38.1",
  "description": "WaioPrime API — Fastify + TypeScript + Prisma + PostgreSQL",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env.dev src/app/server.ts --host",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/app/server.js",
    "start:migrate": "node scripts/prisma-migrate-deploy-with-retry.mjs && node dist/app/server.js",
    "restart": "pnpm prisma:generate && pnpm prisma:migrate && pnpm prisma:seed && node dist/app/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "node scripts/prisma-migrate-deploy-with-retry.mjs",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.679.0",
    "@aws-sdk/s3-request-presigner": "3.679.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "@fastify/websocket": "^8.3.1",
    "@prisma/client": "^5.22.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "fastify": "^4.28.1",
    "nodemailer": "^10.2.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "ws": "^8.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "protobufjs",
      "sharp",
      "@whiskeysockets/baileys"
    ]
  }
}
