# ─────────────────────────────────────────────────────────────────────────────
# Washoot API — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=192.168.100.44

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Docker local: postgresql://washot:washot@localhost:5432/washot?schema=public
DATABASE_URL=postgresql://washot:washot@localhost:5432/washot?schema=public

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=change_me_to_a_strong_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Set to true only in development for human-readable logs
LOG_PRETTY=true

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api
# Comma-separated origins or * for all
CORS_ORIGIN=*
