# ─────────────────────────────────────────────────────────────────────────────
# WaioPrime API — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
#
# ⚠️  DOCKER: Ao rodar via Docker Compose, altere apenas:
#    - DATABASE_URL → use o nome do serviço "postgres" em vez de "localhost"
#      Exemplo: postgresql://waioprime:waioprime@postgres:5432/waioprime?schema=public
#    - HOST → use 0.0.0.0
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
# Local dev: seu IP ou 0.0.0.0 | Docker: 0.0.0.0
HOST=0.0.0.0

# ── PostgreSQL (usado pelo docker-compose para inicializar o container) ───────
POSTGRES_USER=waioprime
POSTGRES_PASSWORD=waioprime
POSTGRES_DB=waioprime
# Porta exposta no host (fora do container)
POSTGRES_PORT=5440

# ── Database ──────────────────────────────────────────────────────────────────
# Desenvolvimento local (sem Docker): host=localhost, porta=POSTGRES_PORT
# DATABASE_URL=postgresql://waioprime:waioprime@localhost:5435/waioprime?schema=public
#
# Docker Compose: host=postgres (nome do serviço), porta interna=5440
#DATABASE_URL=postgresql://waioprime:waioprime@postgres:5440/waioprime?schema=public
# connection_limit=5 em produção: limita o pool Prisma por processo (doc: arquitetura-escala.md)
# DATABASE_URL=postgresql://waioprime:waioprime@localhost:5440/waioprime?schema=public&connection_limit=5

# BANCO REAL DE PRODUCAO ATUAL NA REDER DO WAIOCHAT
# DATABASE_URL=postgresql://waiochat_jesus:OkIsmdZTOzi36eqfZHwuME4lMhGAKbVd@dpg-d7oihnqpmmbs73b714s0-a.virginia-postgres.render.com/waioprime?sslmode=require

# BANCO REAL DE PRODUCAO ATUAL NA REDER DO PULSOSOCIAL: PROJETO COPYSYNC
 DATABASE_URL=postgresql://database_user:<PASSWORD>@dpg-dbfn1clg1s2s738drg0g-a/db_copysync_postgres

# ── Authentication ────────────────────────────────────────────────────────────
# Gere um secret forte: openssl rand -hex 32
JWT_SECRET=466ffe95e99e50c85cb5fae379e932695cc662b63972c1776de08ca0f032c13e
JWT_ACCESS_EXPIRES_IN=8h #Era 15m alterado em 11/05/26 14:01h
JWT_REFRESH_EXPIRES_IN=7d

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# true apenas em desenvolvimento para logs legíveis por humanos
LOG_PRETTY=true

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api
# Origens separadas por vírgula ou * para todas
CORS_ORIGIN=*

# ── Storage ───────────────────────────────────────────────────────────────────
# Local dev: ./storage | Docker: /app/storage (mapeado por volume)
STORAGE_PATH=./storage

# Baileys: Sincronizar histórico completo do WhatsApp ao iniciar (true/false)
BAILEYS_SYNC_FULL_HISTORY=false

# ── Gerador de ofertas ────────────────────────────────────────────────────────
# Worker de envios. Só `true` com DATABASE_URL de banco local: o DATABASE_URL ativo acima
# é o banco real do CopySync na Render (AGENTS §22).
OFFER_DISPATCH_WORKER_ENABLED=false
